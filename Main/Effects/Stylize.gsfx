// GeSe built-in effects: Stylize

@effect Glow
@id gese.sty.glow
@category Stylize
@desc Glows the bright parts of the image. Intensity is the glow strength (up to 200%).
@passes 3
@mix manual
@param float threshold "Glow Threshold" 60 0 100 %
@param float radius "Glow Radius" 40 0 500 px
@param float strength "Glow Intensity" 1.5 0 10
@param choice glowColors "Glow Colors" 0 "Original Colors|Tint"
@param color tint "Tint Color" 1 0.533 0.004 1
@code
float4 effect(float2 uv) {
    if (PASS == 0) {
        float r = max(PX(radius), 1.0);
        int n = (int)clamp(r, 1.0, 40.0);
        float st = r / n, sigma = r * 0.5;
        float3 acc = 0; float ws = 0;
        [loop] for (int i = -n; i <= n; i++) {
            float4 c = ORIG(uv + float2(i * st, 0) * TEXEL);
            float k = smoothstep(threshold / 100.0 - 0.05, threshold / 100.0 + 0.05, luma(c.rgb)) * c.a;
            float w = gauss(i * st, sigma);
            acc += c.rgb * k * w; ws += w;
        }
        return float4(acc / ws, 1);
    }
    if (PASS == 1) {
        float r = max(PX(radius), 1.0);
        int n = (int)clamp(r, 1.0, 40.0);
        float st = r / n, sigma = r * 0.5;
        float3 acc = 0; float ws = 0;
        [loop] for (int i = -n; i <= n; i++) { float w = gauss(i * st, sigma); acc += gSrc.SampleLevel(gLin, uv + float2(0, i * st) * TEXEL, 0).rgb * w; ws += w; }
        return float4(acc / ws, 1);
    }
    float3 g = gSrc.SampleLevel(gLin, uv, 0).rgb;
    if (glowColors == 1) g = luma(g) * tint.rgb * 1.5;
    g *= strength * INTENSITY;
    float4 o = ORIG(uv);
    float a = saturate(o.a + luma(g));
    float3 rgb = (o.rgb * o.a + g) / max(a, 1e-4);
    return float4(rgb, a);
}
@end

@effect Find Edges
@id gese.sty.findedges
@category Stylize
@param bool invertE "Invert" 0
@code
float4 effect(float2 uv) {
    float2 t = TEXEL;
    float tl = luma(SRC(uv + float2(-t.x, -t.y)).rgb), tc = luma(SRC(uv + float2(0, -t.y)).rgb), tr = luma(SRC(uv + float2(t.x, -t.y)).rgb);
    float ml = luma(SRC(uv + float2(-t.x, 0)).rgb), mr = luma(SRC(uv + float2(t.x, 0)).rgb);
    float bl = luma(SRC(uv + float2(-t.x, t.y)).rgb), bc = luma(SRC(uv + float2(0, t.y)).rgb), br = luma(SRC(uv + float2(t.x, t.y)).rgb);
    float gx = -tl - 2.0 * ml - bl + tr + 2.0 * mr + br;
    float gy = -tl - 2.0 * tc - tr + bl + 2.0 * bc + br;
    float e = saturate(length(float2(gx, gy)));
    if (!invertE) e = 1.0 - e;
    return float4(e, e, e, SRC(uv).a);
}
@end

@effect Emboss
@id gese.sty.emboss
@category Stylize
@param angle direction "Direction" 45
@param float relief "Relief" 2 0.5 20 px
@param float contrastV "Contrast" 150 0 500 %
@code
float4 effect(float2 uv) {
    float a = radians(direction);
    float2 o = float2(cos(a), sin(a)) * PX(relief) * TEXEL;
    float d = luma(SRC(uv + o).rgb) - luma(SRC(uv - o).rgb);
    float v = 0.5 + d * contrastV / 100.0;
    return float4(v, v, v, SRC(uv).a);
}
@end

@effect Mosaic
@id gese.sty.mosaic
@category Stylize
@param float hBlocks "Horizontal Blocks" 40 1 2000
@param float vBlocks "Vertical Blocks" 24 1 2000
@param bool sharpColors "Sharp Colors" 1
@code
float4 effect(float2 uv) {
    float2 n = max(float2(hBlocks, vBlocks), 1.0);
    float2 q = (floor(uv * n) + 0.5) / n;
    if (sharpColors) return SRC(q);
    float4 acc = 0;
    [unroll] for (int y = -1; y <= 1; y++) [unroll] for (int x = -1; x <= 1; x++) acc += SRCP(q + float2(x, y) / n * 0.3);
    return unpremul(acc / 9.0);
}
@end

@effect Posterize
@id gese.sty.posterize
@category Stylize
@param float levels "Level" 6 2 64
@code
float4 effect(float2 uv) {
    float4 c = SRC(uv);
    float n = max(round(levels) - 1.0, 1.0);
    c.rgb = floor(saturate(c.rgb) * n + 0.5) / n;
    return c;
}
@end

@effect Threshold
@id gese.sty.threshold
@category Stylize
@param float level "Level" 50 0 100 %
@param float softness "Softness" 0 0 50 %
@code
float4 effect(float2 uv) {
    float4 c = SRC(uv);
    float s = softness / 100.0 + 1e-4;
    float v = smoothstep(level / 100.0 - s, level / 100.0 + s, luma(c.rgb));
    return float4(v, v, v, c.a);
}
@end

@effect Halftone
@id gese.sty.halftone
@category Stylize
@param float dotSize "Dot Size" 10 2 200 px
@param angle dotAngle "Angle" 45
@param choice colorMode "Color" 0 "Monochrome|Color (CMY)"
@code
float dotAt(float2 p, float ang, float v, float sz) {
    float2 q = rot2(p, ang) / sz;
    float2 f = frac(q) - 0.5;
    float r = sqrt(saturate(v)) * 0.7;
    return 1.0 - smoothstep(r - 0.08, r + 0.08, length(f));
}
float4 effect(float2 uv) {
    float4 c = SRC(uv);
    float2 p = uv * RES;
    float sz = max(PX(dotSize), 2.0);
    float a = radians(dotAngle);
    if (colorMode == 0) { float d = dotAt(p, a, 1.0 - luma(c.rgb), sz); return float4(1.0 - d, 1.0 - d, 1.0 - d, c.a); }
    float3 cmy = 1.0 - saturate(c.rgb);
    float3 o = float3(1.0 - dotAt(p, a, cmy.r, sz), 1.0 - dotAt(p, a + 0.26, cmy.g, sz), 1.0 - dotAt(p, a + 0.52, cmy.b, sz));
    return float4(o, c.a);
}
@end

@effect Cartoon
@id gese.sty.cartoon
@category Stylize
@param float levels "Shading Steps" 5 2 16
@param float edgeThresh "Edge Threshold" 25 1 100 %
@param float edgeWidth "Edge Width" 1.5 0.5 8 px
@code
float4 effect(float2 uv) {
    float4 c = SRC(uv);
    float2 t = TEXEL * PX(edgeWidth);
    float gx = luma(SRC(uv + float2(t.x, 0)).rgb) - luma(SRC(uv - float2(t.x, 0)).rgb);
    float gy = luma(SRC(uv + float2(0, t.y)).rgb) - luma(SRC(uv - float2(0, t.y)).rgb);
    float e = smoothstep(edgeThresh / 100.0 * 0.5, edgeThresh / 100.0, length(float2(gx, gy)));
    float3 hsv = rgb2hsv(saturate(c.rgb));
    float n = max(levels - 1.0, 1.0);
    hsv.z = floor(hsv.z * n + 0.5) / n;
    hsv.y = saturate(hsv.y * 1.2);
    c.rgb = hsv2rgb(hsv) * (1.0 - e);
    return c;
}
@end

@effect Oil Paint
@id gese.sty.oilpaint
@category Stylize
@desc Kuwahara painterly filter.
@param float radius "Brush Size" 4 1 8 px
@code
float4 effect(float2 uv) {
    int n = (int)clamp(PX(radius), 1.0, 8.0);
    float3 m[4]; float3 s[4];
    [unroll] for (int k = 0; k < 4; k++) { m[k] = 0; s[k] = 0; }
    float cnt = (n + 1) * (n + 1);
    [loop] for (int y = 0; y <= n; y++)
        [loop] for (int x = 0; x <= n; x++) {
            float3 c0 = SRC(uv + float2(-x, -y) * TEXEL).rgb, c1 = SRC(uv + float2(x, -y) * TEXEL).rgb;
            float3 c2 = SRC(uv + float2(-x, y) * TEXEL).rgb, c3 = SRC(uv + float2(x, y) * TEXEL).rgb;
            m[0] += c0; s[0] += c0 * c0; m[1] += c1; s[1] += c1 * c1; m[2] += c2; s[2] += c2 * c2; m[3] += c3; s[3] += c3 * c3;
        }
    float best = 1e9; float3 res = 0;
    [unroll] for (int j = 0; j < 4; j++) {
        float3 mu = m[j] / cnt;
        float3 v = abs(s[j] / cnt - mu * mu);
        float sg = v.r + v.g + v.b;
        if (sg < best) { best = sg; res = mu; }
    }
    return float4(res, SRC(uv).a);
}
@end

@effect Scanlines
@id gese.sty.scanlines
@category Stylize
@speed
@param float spacing "Line Spacing" 4 1 100 px
@param float thickness "Thickness" 50 1 100 %
@param float darkness "Darkness" 50 0 100 %
@param float scroll "Scroll" 0 -200 200 px/s
@code
float4 effect(float2 uv) {
    float4 c = SRC(uv);
    float y = uv.y * RES.y + PX(scroll) * PHASE;
    float f = frac(y / max(PX(spacing), 1.0));
    float m = step(1.0 - thickness / 100.0, f);
    c.rgb *= 1.0 - m * darkness / 100.0;
    return c;
}
@end

@effect Strobe Light
@id gese.sty.strobe
@category Stylize
@speed
@param color strobeColor "Strobe Color" 1 1 1 1
@param float freq "Strobe Period" 0.25 0.02 5 sec
@param float duty "Strobe Duration" 0.06 0.01 5 sec
@param choice strobeType "Type" 0 "Operates on Color|Makes Layer Transparent|Inverts"
@code
float4 effect(float2 uv) {
    float4 c = SRC(uv);
    float on = step(fmod(PHASE, max(freq, 0.01)), duty);
    if (strobeType == 0) c.rgb = lerp(c.rgb, strobeColor.rgb, on * strobeColor.a);
    else if (strobeType == 1) c.a *= 1.0 - on;
    else c.rgb = lerp(c.rgb, 1.0 - c.rgb, on);
    return c;
}
@end

@effect Neon Edges
@id gese.sty.neon
@category Stylize
@param color neonColor "Color" 1 0.533 0.004 1
@param float width "Width" 2 0.5 10 px
@param float glowAmt "Glow" 1.5 0 6
@param bool keepImage "Keep Image" 0
@code
float edgeAt(float2 uv, float w) {
    float2 t = TEXEL * w;
    float gx = luma(SRC(uv + float2(t.x, 0)).rgb) - luma(SRC(uv - float2(t.x, 0)).rgb);
    float gy = luma(SRC(uv + float2(0, t.y)).rgb) - luma(SRC(uv - float2(0, t.y)).rgb);
    return saturate(length(float2(gx, gy)) * 3.0);
}
float4 effect(float2 uv) {
    float w = PX(width);
    float e = edgeAt(uv, w);
    float g = 0;
    [unroll] for (int i = 0; i < 8; i++) { float a = i * 0.785398; g += edgeAt(uv + float2(cos(a), sin(a)) * TEXEL * w * 3.0, w); }
    float3 col = neonColor.rgb * (e + g / 8.0 * glowAmt);
    float4 c = SRC(uv);
    if (keepImage) return float4(c.rgb * 0.35 + col, c.a);
    return float4(col, c.a);
}
@end

@effect Solarize
@id gese.sty.solarize
@category Stylize
@param float threshold "Threshold" 50 0 100 %
@code
float4 effect(float2 uv) {
    float4 c = SRC(uv);
    float th = threshold / 100.0;
    c.rgb = float3(c.r > th ? 1.0 - c.r : c.r, c.g > th ? 1.0 - c.g : c.g, c.b > th ? 1.0 - c.b : c.b) * (0.5 / max(min(th, 1.0 - th), 0.05));
    return c;
}
@end

@effect Dither
@id gese.sty.dither
@category Stylize
@desc Ordered (Bayer) dithering for a retro look.
@param float levels "Colors per Channel" 4 2 32
@param float pixelSize "Pixel Size" 2 1 32 px
@param bool mono "Monochrome" 0
@code
float bayer(float2 p) {
    int x = (int)fmod(p.x, 4.0), y = (int)fmod(p.y, 4.0);
    int i = x + y * 4;
    float m[16] = {0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5};
    return m[i] / 16.0 - 0.5;
}
float4 effect(float2 uv) {
    float ps = max(PX(pixelSize), 1.0);
    float2 cell = floor(uv * RES / ps);
    float4 c = SRC((cell + 0.5) * ps / RES);
    float n = max(levels - 1.0, 1.0);
    float3 v = mono ? luma(c.rgb).xxx : c.rgb;
    v = floor(saturate(v) * n + 0.5 + bayer(cell)) / n;
    return float4(v, c.a);
}
@end

@effect Pencil Sketch
@id gese.sty.sketch
@category Stylize
@param float strength "Line Strength" 60 0 100 %
@param float paper "Paper Brightness" 95 50 100 %
@code
float4 effect(float2 uv) {
    float4 c = SRC(uv);
    float l = luma(c.rgb);
    float b = 0;
    [unroll] for (int i = 0; i < 12; i++) { float a = i * 2.39996; float r = sqrt((i + 0.5) / 12.0) * 3.0; b += luma(SRC(uv + float2(cos(a), sin(a)) * r * TEXEL * RSCALE * 2.0).rgb); }
    b /= 12.0;
    float sk = saturate(l / max(b, 1e-3));
    sk = pow(sk, 1.0 + strength / 25.0);
    float v = sk * paper / 100.0;
    return float4(v, v, v, c.a);
}
@end

@effect LED Screen
@id gese.sty.led
@category Stylize
@desc Dot matrix / LED wall look.
@param float cell "Cell Size" 10 3 100 px
@param float gap "Gap" 30 0 80 %
@param bool roundLed "Round LEDs" 1
@param float boost "Brightness" 1.3 0.5 3
@code
float4 effect(float2 uv) {
    float cs = max(PX(cell), 2.0);
    float2 g = uv * RES / cs;
    float2 f = frac(g) - 0.5;
    float4 c = SRC((floor(g) + 0.5) * cs / RES);
    float r = 0.5 * (1.0 - gap / 100.0);
    float m = roundLed ? 1.0 - smoothstep(r - 0.06, r + 0.02, length(f)) : step(abs(f.x), r) * step(abs(f.y), r);
    return float4(c.rgb * m * boost, c.a);
}
@end

@effect Roughen Edges
@id gese.sty.roughen
@category Stylize
@desc Rough, eroded alpha edges (great on text).
@speed
@param float border "Border" 8 0 200 px
@param float rScale "Scale" 30 2 500 px
@param float evoSpeed "Evolution Speed" 0 0 10
@code
float4 effect(float2 uv) {
    float4 c = SRC(uv);
    float n = fbm3(float3(uv * RES / max(PX(rScale), 1.0), PHASE * evoSpeed), 4);
    float b = 0;
    [unroll] for (int i = 0; i < 8; i++) { float a = i * 0.785398; b += SRC(uv + float2(cos(a), sin(a)) * PX(border) * TEXEL).a; }
    b /= 8.0;
    float edge = 1.0 - b;
    c.a *= saturate(1.0 - step(n, edge * 1.2) * smoothstep(0.0, 0.3, edge) * 1.0);
    return c;
}
@end

@effect Brush Strokes
@id gese.sty.brush
@category Stylize
@param float strokeLen "Stroke Length" 12 1 80 px
@param angle strokeAngle "Stroke Angle" 135
@param float randomness "Randomness" 40 0 100 %
@code
float4 effect(float2 uv) {
    float a = radians(strokeAngle) + (vnoise(uv * RES / 20.0) - 0.5) * randomness / 100.0 * 2.0;
    float2 d = float2(cos(a), sin(a)) * PX(strokeLen) * TEXEL;
    float4 acc = 0;
    const int N = 16;
    [loop] for (int i = 0; i < N; i++) acc += SRCP(uv + d * (i / (float)(N - 1) - 0.5));
    float4 c = unpremul(acc / N);
    c.rgb *= 0.92 + vnoise(uv * RES / 3.0) * 0.16;
    return c;
}
@end
